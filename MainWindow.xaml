<Window x:Class="SmartAnuariosPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartAnuariosPro"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="SmartAnuarios Pro v2026 - Suite de Producción Industrial"
        Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#121212">

    <Window.Resources>
        
        <local:EmpezarConBombaConverter x:Key="EmpezarConBombaConverter"/>
        
        <!-- Instanciamos el convertidor EXIF para que el motor XAML lo reconozca -->
        <local:RotadorExifAutomatizado x:Key="RotadorExifAutomatizado"/>
        <local:SexoNullConverter x:Key="ConvertidorSexoNull"/>
        <local:FotoNullConverter x:Key="ConvertidorFotoNull"/>
        

        <!-- 🎨 Colores Modo Oscuro Originales (Estilo Lightroom / FastStone) -->
        <SolidColorBrush x:Key="FondoOscuro" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="FondoMesa" Color="#252526"/>
        <SolidColorBrush x:Key="FondoPanel" Color="#151515"/>
        <SolidColorBrush x:Key="BordeContenedor" Color="#3F3F46"/>
        <SolidColorBrush x:Key="TextoPrincipal" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="AzulAcento" Color="#007ACC"/>
        <SolidColorBrush x:Key="RojoPeligro" Color="#D32F2F"/>
        <SolidColorBrush x:Key="VerdeExito" Color="#2E7D32"/>
        <SolidColorBrush x:Key="AzulConsultaMesa" Color="#00528a"/>

        <!-- 0. Menú contextual oscuro reutilizable -->
        <ContextMenu x:Key="MenuOscuroTextBox">
            <MenuItem Command="ApplicationCommands.Cut" Header="Cortar"/>
            <MenuItem Command="ApplicationCommands.Copy" Header="Copiar"/>
            <MenuItem Command="ApplicationCommands.Paste" Header="Pegar"/>
            <Separator/>
            <MenuItem Command="ApplicationCommands.SelectAll" Header="Seleccionar Todo"/>
        </ContextMenu>

        <!-- 📐 ESTILO REDONDEADO COMPACTO PARA TU SUITE (Inmune al conflicto) -->
        <Style x:Key="TextBoxRedondeadoPro" TargetType="TextBox">
            <Setter Property="ContextMenu" Value="{StaticResource MenuOscuroTextBox}"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <!-- El color de fondo que usas -->
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordeContenedor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- El borde se encarga de pintar de forma absoluta el fondo y las esquinas de 4px -->
                        <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                            <!-- Contenedor nativo de texto aislado -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#151515"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AzulAcento}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. Forzar contenedor oscuro para CUALQUIER menú de clic derecho -->
        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3" Padding="2">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Forzar diseño oscuro unificado a CUALQUIER elemento de lista del menú -->
        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True" Padding="12,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="#8E8E93" Margin="25,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="BgBorder" Value="#007ACC" Property="Background"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4F4F4F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. Estilo para líneas divisorias internas oscuras -->
        <Style TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#3F3F46" Margin="4,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 5. 📐 RECONSTRUCCIÓN COMPLETA DEL COMBOBOX (100% PLANO, OSCURO E INMUNE A WINDOWS) -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordeContenedor}"/>
            <Setter Property="BorderThickness" Value="1"/>

            <!-- 🔒 FIJADO DIRECTO: Evita que busque al ancestro en el árbol visual del DataGrid -->
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#252526"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <!-- 🔒 ANCLAJE CRÍTICO ANTI-ADVERTENCIAS: Fuerza valores planos fijos -->
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0056b3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <!-- 🛠️ EL SECRETO: Rediseño absoluto de la plantilla para borrar las líneas blancas nativas -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>

                            <!-- Botón Invisible / Área interactiva que despliega la lista -->
                            <ToggleButton x:Name="ToggleButton" 
                                          Grid.ColumnSpan="2"
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Background="{TemplateBinding Background}" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Focusable="false"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <!-- Borde maestro oscuro plano con esquinas redondeadas de 4px -->
                                        <Border x:Name="Chrome" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="4" 
                                                SnapsToDevicePixels="true">
                                            <!-- Flecha del ComboBox pintada de color gris claro premium -->
                                            <Grid HorizontalAlignment="Right" Width="25" Margin="0,0,5,0">
                                                <Path x:Name="Arrow" 
                                                      Fill="#A1A1AA" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" 
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#007ACC"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="true">
                                                <Setter TargetName="Chrome" Property="Background" Value="#252526"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Contenedor del texto seleccionado visible en la caja principal -->
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="{TemplateBinding Padding}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                            <!-- Menú Flotante Desplegable (Popup) sin bordes ni sombras de Windows -->
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="true" 
                                   Focusable="false" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="true" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#252526" 
                                            BorderBrush="{StaticResource BordeContenedor}" 
                                            BorderThickness="1" 
                                            CornerRadius="4"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="1" SnapsToDevicePixels="true" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#555555"/>
                                <Setter Property="Background" Value="#151515"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="true">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 📌 RECURSO GLOBAL PROGRESSBAR REPARADO (Líneas 142+) -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                            <Grid x:Name="TemplateRoot">
                                <!-- INDICADOR NATIVO ASOCIADO AL MOTOR GRÁFICO -->
                                <Border x:Name="PART_Indicator" 
                                        HorizontalAlignment="Left" 
                                        Background="#007ACC" 
                                        CornerRadius="4"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Headers de DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- 📐 Incrementamos el tamaño del texto de la cabecera -->
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- 7. 🛠️ BOTÓN PRO MEJORADO: Esquinas redondeadas y 100% inmune al blanco de Windows -->
        <Style x:Key="BotónPro" TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 📐 Curvatura de 4px asignada por plantilla al borde -->
                        <Border x:Name="BtnBorder" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover: Coloración industrial al pasar el cursor -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#505054"/>
                            </Trigger>
                            <!-- 🛡️ DISPARADOR INDUSTRIAL: Mantiene su color oscuro original y aplica opacidad elegante al desactivarse -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3E3E42"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 📌 BOTÓN VERDE REDONDEADO INMUNE AL BLANCO -->
        <Style x:Key="BotónExitoPro" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource VerdeExito}"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 📐 Aquí inyectamos la curvatura exacta de 4px -->
                        <Border x:Name="BtnBorder" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover: Oscurece sutilmente el verde al pasar el ratón -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#225E26"/>
                            </Trigger>
                            <!-- 🛡️ Bloqueo anti-blanqueo de Windows: Mantiene el verde con opacidad tenue -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource VerdeExito}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 📌 BOTÓN COMPACTO OSCURO REDONDEADO INMUNE AL BLANCO -->
        <Style x:Key="BotónCompactoPro" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 📐 Curvatura de 3px ideal para tamaños de control pequeños -->
                        <Border x:Name="BtnBorder" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover: Aclara el gris cuando pasas el cursor -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <!-- 🛡️ Bloqueo anti-blanqueo de Windows: Retiene el gris oscuro original con opacidad -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
  
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🏢 BARRA DE TÍTULO MAESTRA CORPORATIVA (CON EL NUEVO ISOTIPO VECTORIAL) -->
        <StackPanel Orientation="Horizontal" Background="#111C24" Height="35" VerticalAlignment="Top">

            <!-- 🎨 EL ISOTIPO DE HARDWARE: Se ubica en la esquina superior izquierda general del programa -->
            <Viewbox Width="18" Height="18" Margin="15,0,8,0" VerticalAlignment="Center" ToolTip="SmartAnuariosPro v2026">
                <Grid Width="64" Height="64">
                    <Ellipse Stroke="#1F384D" StrokeThickness="4" Fill="#111C24"/>
                    <Ellipse Stroke="#63B3ED" StrokeThickness="1.5" Margin="6"/>
                    <Path Data="M 32,4 L 48,20 L 32,36 Z" Fill="#007ACC" Opacity="0.4"/>
                    <Path Data="M 60,32 L 44,48 L 28,32 Z" Fill="#00528A" Opacity="0.6"/>
                    <Path Data="M 32,60 L 16,44 L 32,28 Z" Fill="#63B3ED" Opacity="0.5"/>
                    <Path Data="M 4,32 L 20,16 L 36,32 Z" Fill="#1F384D" Opacity="0.7"/>
                    <Ellipse Width="10" Height="10" Fill="#00D2FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00D2FF" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>
            </Viewbox>

            <!-- Tus textos originales continúan aquí abajo de forma fluida -->
            <TextBlock Text="SmartAnuariosPro" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
            <!-- 🟢 CORREGIDO: En la línea 1011 quita el x:Name para eliminar la duplicidad en el compilador -->
            <TextBlock Text=" | NINGÚN COLEGIO SELECCIONADO" Foreground="#666666" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <!-- 🚨 BANNER DE NOTIFICACIÓN COMPLETO E INTERACTIVO EN MODO OSCURO -->
        <Border x:Name="BannerNotificacion" 
                Grid.Row="0"
                Panel.ZIndex="99" 
                Background="#D4AC0D" 
                Height="0" 
                VerticalAlignment="Top"
                CornerRadius="0,0,4,4"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <!-- 🎬 ANIMACIÓN DETECTOR DE ACCIÓN CON EL EMOTE DE BOMBA -->
                        <DataTrigger Binding="{Binding ElementName=TxtMensajeBanner, Path=Text, Converter={StaticResource EmpezarConBombaConverter}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="StoryboardPulsoRojo">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1.0" To="0.3" 
                                                         Duration="0:0:0.5"
                                                         Timeline.DesiredFrameRate="60"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="StoryboardPulsoRojo"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TEXTO DE ESTADO ORDINARIO / CABECERA DE CONFLICTO -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtMensajeBanner" 
                               Text="Mensaje del sistema..." 
                               Foreground="#1E1E1E" 
                               FontWeight="Bold" 
                               FontSize="12" 
                               TextWrapping="Wrap"/>

                    <!-- 🔬 MESA VISUAL SIDE-BY-SIDE DE COMPARACIÓN CRÍTICA (Se activa solo en conflicto) -->
                    <Grid x:Name="GridComparacionConflicto" Visibility="Collapsed" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#151515" CornerRadius="4" Padding="8,4" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💻 Tus Cambios locales: " Foreground="#A1A1AA" FontSize="11"/>
                                <TextBlock x:Name="TxtCambiosAlexander" Text="Foto: _DSC123.jpg | Sexo: M" Foreground="#63B3ED" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1E1212" CornerRadius="4" Padding="8,4" BorderBrush="#7A1C1C" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📱 Guardado por el Padre: " Foreground="#A1A1AA" FontSize="11"/>
                                <TextBlock x:Name="TxtCambiosPadre" Text="Foto: _DSC999.jpg | Sexo: F" Foreground="#FF5252" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- BOTONERA DE RESPUESTA INTERACTIVA MULTIFUNCIÓN -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                    <!-- A. Botones para Destrucción y Confirmación Ordinaria -->
                    <StackPanel x:Name="PanelAccionesDestruccion" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,10,0">
                        <Button x:Name="BtnConfirmarBorradoBanner" Content="✓ SÍ, PROCEDER" Background="#151515" Foreground="White" FontWeight="Bold" FontSize="11" Padding="14,4" Height="28" Margin="0,0,8,0" Click="BtnConfirmarBorradoBanner_Click"/>
                        <Button x:Name="BtnCancelarBorradoBanner" Content="✕ NO, CANCELAR" Background="#3E3E42" Foreground="White" FontWeight="Bold" FontSize="11" Padding="14,4" Height="28" Click="BtnCancelarBorradoBanner_Click"/>
                    </StackPanel>

                    <!-- B. 🔗 NUEVOS BOTONES EXCLUSIVOS PARA LA PASARELA DE CONFLICTOS -->
                    <StackPanel x:Name="PanelAccionesConflicto" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,10,0">
                        <Button x:Name="BtnConservarPadre" Content="📱 CONSERVAR LO DEL PADRE" Background="#2E7D32" Foreground="White" FontWeight="Bold" FontSize="11" Padding="12,4" Height="28" Margin="0,0,8,0" Click="BtnResolucionConflicto_Click" Tag="PADRE"/>
                        <Button x:Name="BtnConservarAlexander" Content="💻 FORZAR MIS CAMBIOS" Background="#C0392B" Foreground="White" FontWeight="Bold" FontSize="11" Padding="12,4" Height="28" Click="BtnResolucionConflicto_Click" Tag="ALEXANDER"/>
                    </StackPanel>

                    <!-- Botón ordinario de cierre "✕" -->
                    <Button x:Name="BtnCerrarBannerOrdinario" Content="✕" Background="Transparent" Foreground="#1E1E1E" FontWeight="Bold" FontSize="13" Cursor="Hand" BorderThickness="0" Height="30" Padding="12,0" Click="BtnCerrarBanner_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BARRA SUPERIOR DE CONTROL -->
        <Border Grid.Row="0" Background="{StaticResource FondoOscuro}" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SMART ANUARIOS PRO" Foreground="{StaticResource TextoPrincipal}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,25,0"/>
                    <Border Background="#151515" CornerRadius="4" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1" Padding="8,4" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙ Carpeta Maestra:" Foreground="{StaticResource TextoSecundario}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtRutaCarpetaMaestra" Text="D:\Anuarios 2026\" Foreground="{StaticResource AzulAcento}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="BtnCambiarCarpetaMaestra" 
                                Style="{StaticResource BotónCompactoPro}"
                                Content="..." 
                                Width="24" 
                                Height="20" 
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Licencia: Estudio/Laboratorio" Foreground="{StaticResource TextoSecundario}" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="11"/>
                    <Border Background="{StaticResource VerdeExito}" CornerRadius="4" Padding="10,5">
                        <TextBlock Text="Pixeleduca MySQL Conectado" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- CUERPO CENTRAL: PESTAÑAS CHROME LATERALES -->
        <Grid Grid.Row="1" Margin="15">
            <TabControl x:Name="ContenedorPrincipalModulos" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" SelectedIndex="0">
                <TabControl.Resources>
                    <Style TargetType="TabPanel">
                        <Setter Property="Margin" Value="0,0,5,0"/>
                    </Style>
                    <Style TargetType="TabItem">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextoPrincipal}" FontSize="13" FontWeight="SemiBold" Margin="15,14"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Margin" Value="0,0,0,4"/>
                        <Setter Property="Width" Value="220"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Background="Transparent" CornerRadius="6,0,0,6">
                                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Left" ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#2D2D30"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource FondoOscuro}"/>
                                            <Setter Property="Panel.ZIndex" Value="100"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <!-- ========================================== -->
                <!-- 1° MÓDULO: CONTROL DE COLEGIOS             -->
                <!-- ========================================== -->
                <TabItem Header="📁 Control de Colegios">
                    <Grid Background="{StaticResource FondoOscuro}">
                        <TabControl x:Name="SubContenedorColegios" TabStripPlacement="Top" Background="Transparent" BorderThickness="0" Margin="15">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="HeaderTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextoPrincipal}" FontSize="12" FontWeight="SemiBold" Margin="14,6"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Margin" Value="0,0,4,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="SubBorder" Background="#3E3E42" CornerRadius="4,4,0,0">
                                                    <ContentPresenter x:Name="SubContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SubBorder" Property="Background" Value="#505054"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="SubBorder" Property="Background" Value="{StaticResource FondoMesa}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.Resources>

                            <!-- SUB-PESTAÑA 1: INGRESSAR COLEGIO -->
                            <TabItem Header="➕ Ingresar Colegio">
                                <Grid Background="{StaticResource FondoMesa}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56*"/>
                                        <ColumnDefinition Width="213*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="20,15,20,5" Grid.ColumnSpan="2">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- FILA 1: DATOS GENERALES DEL COLEGIO -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,12">
                                                <TextBlock Text="Código (Sin espacios):" Foreground="{StaticResource TextoSecundario}" FontSize="11" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                                <TextBox x:Name="TxtIngresarCodigoColegio" Style="{StaticResource TextBoxRedondeadoPro}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,15,12">
                                                <TextBlock Text="Institución:" Foreground="{StaticResource TextoSecundario}" FontSize="11" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                                <TextBox x:Name="TxtIngresarNombreColegio" Style="{StaticResource TextBoxRedondeadoPro}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,15,12">
                                                <TextBlock Text="Fotógrafo:" Foreground="{StaticResource TextoSecundario}" FontSize="11" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                                <TextBox x:Name="TxtIngresarFotografo" Style="{StaticResource TextBoxRedondeadoPro}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="3" VerticalAlignment="Bottom" Margin="5,0,0,17">
                                                <CheckBox x:Name="ChkOmitirFamiliar" 
                                                          Content="🚫 Omitir Sección Familiar" 
                                                          Foreground="{StaticResource TextoPrincipal}" 
                                                          FontWeight="Bold" 
                                                          FontSize="12"
                                                          Cursor="Hand"
                                                          VerticalContentAlignment="Center"
                                                          Height="28">
                                                    <CheckBox.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="3"/>
                                                        </Style>
                                                    </CheckBox.Resources>
                                                </CheckBox>
                                            </StackPanel>

                                            <!-- FILA 2: CONFIGURACIÓN DEL ORIGEN DE FOTOS CRUDAS (SD, USB o Carpeta Externa) -->
                                            <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,5,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="📷 Origen de Fotos Crudas (SD, USB, Disco o Carpeta Externa):" Foreground="{StaticResource TextoSecundario}" FontSize="11" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                                    <TextBox x:Name="TxtRutaFotosCrudasOrigen" Style="{StaticResource TextBoxRedondeadoPro}" IsReadOnly="True" Background="#1A1A1C"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                                    <Button x:Name="BtnExaminarCrudasOrigen" 
                                                            Style="{StaticResource BotónPro}" 
                                                            Content="Examinar Origen..." 
                                                            Padding="15,6" 
                                                            Height="30"
                                                            VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>


                                    <!-- 🔹 SECCIÓN DE CARGA MASIVA: EN DOS TARJETAS AZULES INDEPENDIENTES SEPARADAS -->
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="20,10,20,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <!-- Separación exacta idéntica a tus márgenes -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 🟢 TARJETA A: LOTE DE ROSTROS MASIVO (Estilo Azul Premium) -->
                                        <Border Grid.Column="0" CornerRadius="4" Background="#111C24" BorderBrush="#1F384D" BorderThickness="1" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="📷 Carga Masiva: Lote de Rostros" Foreground="#63B3ED" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Conservamos tu botón original, su nombre y estilo funcional -->
                                                    <Button x:Name="BtnExaminarRostros" Style="{StaticResource BotónPro}" Content="Elegir carpeta..." Padding="12,4"/>
                                                    <TextBlock x:Name="TxtStatusRostros" Text="Sin cargar" Foreground="{StaticResource TextoSecundario}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>

                                                    <!-- ✕ Botón de Limpieza Quirúrgica para Rostros intacto -->
                                                    <Button x:Name="BtnLimpiarRostrosLote" 
                                                            Style="{StaticResource BotónCompactoPro}" 
                                                            Content="✕" 
                                                            Width="20" Height="20" 
                                                            Background="#7A1C1C" Foreground="White" 
                                                            Margin="10,0,0,0" VerticalAlignment="Center" 
                                                            ToolTip="Vaciar lote de retratos seleccionados"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 🟢 TARJETA B: LOTE DE FAMILIAS MASIVO (Estilo Azul Premium) -->
                                        <Border Grid.Column="2" CornerRadius="4" Background="#111C24" BorderBrush="#1F384D" BorderThickness="1" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="👨‍👩‍👧 Carga Masiva: Lote de Familias" Foreground="#63B3ED" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Conservamos tu botón original, su nombre y estilo funcional -->
                                                    <Button x:Name="BtnExaminarFamilias" Style="{StaticResource BotónPro}" Content="Elegir carpeta..." Padding="12,4"/>
                                                    <TextBlock x:Name="TxtStatusFamilias" Text="Sin cargar" Foreground="{StaticResource TextoSecundario}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>

                                                    <!-- ✕ Botón de Limpieza Quirúrgica para Familias intacto -->
                                                    <Button x:Name="BtnLimpiarFamiliasLote" 
                                                            Style="{StaticResource BotónCompactoPro}" 
                                                            Content="✕" 
                                                            Width="20" Height="20" 
                                                            Background="#7A1C1C" Foreground="White" 
                                                            Margin="10,0,0,0" VerticalAlignment="Center" 
                                                            ToolTip="Vaciar lote de fotos familiares"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Grilla de Registro Secuencial -->
                                    <Grid Grid.Row="2" Margin="20,5,20,15" Grid.ColumnSpan="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Contenedor interno con las columnas alineadas y seguras -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 🔢 TextBox N° Orden asignado correctamente a la Columna 0 -->
                                            <TextBox x:Name="TxtAnuarioOrden" 
                                                     Grid.Column="0"
                                                     Margin="0,0,10,0"
                                                     Style="{StaticResource TextBoxRedondeadoPro}"
                                                     VerticalContentAlignment="Center"
                                                     Height="34"/>

                                            <!-- 👤 TextBox Nombre del Alumno asignado correctamente a la Columna 1 -->
                                            <TextBox x:Name="TxtAnuarioNombre" 
                                                     Grid.Column="1"
                                                     Margin="0,0,10,0"
                                                     Style="{StaticResource TextBoxRedondeadoPro}"
                                                     VerticalContentAlignment="Center"
                                                     Height="34"
                                                     AcceptsReturn="True"/>

                                            <!-- ➕ Botón Registrar Alumno asignado correctamente a la Columna 2 -->
                                            <Button x:Name="BtnAnadirAlumnoGrid"
                                                    Grid.Column="2"
                                                    Style="{StaticResource BotónExitoPro}"
                                                    Content="+ Registrar Alumno"
                                                    Height="34"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                        <!-- 💻 DATAGRID DE INGRESO CON FUENTE AMPLIADA -->
                                        <DataGrid Grid.Row="1" 
                                                  x:Name="GridIngresarAlumnos" 
                                                  Background="{StaticResource FondoPanel}" 
                                                  RowBackground="#2D2D30" 
                                                  AlternatingRowBackground="#252526" 
                                                  Foreground="{StaticResource TextoPrincipal}" 
                                                  BorderBrush="{StaticResource BordeContenedor}" 
                                                  BorderThickness="1" 
                                                  AutoGenerateColumns="False" 
                                                  HeadersVisibility="Column" 
                                                  GridLinesVisibility="All" 
                                                  HorizontalGridLinesBrush="#3F3F46" 
                                                  VerticalGridLinesBrush="#3F3F46"
                                                  FontSize="15" 
                                                  RowHeight="32">

                                            <!-- 💻 REEMPLAZA LAS COLUMNAS DE TU DATAGRID CON ESTAS -->
                                            <DataGrid.Columns>

                                                <!-- 🔢 Columna N° Orden CENTRADA -->
                                                <DataGridTextColumn Header="N° Orden" 
                                                    Width="90" 
                                                    Binding="{Binding numero_orden}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- 👤 Columna Nombre del Alumno (Mantiene alineación izquierda natural) -->
                                                <DataGridTextColumn Header="Nombre del Alumno" 
                                                    Width="*" 
                                                    Binding="{Binding nombre_completo}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="Padding" Value="10,0,0,0"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                    
                                    <!-- ✔️ BARRA DE CONTROL INFERIOR CON LAS 4 FASES REALES DEL PIPELINE -->
                                    <Border Grid.Row="3" Background="#1A1A1A" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="0,1,0,0" Padding="20,12" Grid.ColumnSpan="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Panel de textos de estado y barra perfectamente integrados -->
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                    <!-- TxtFotoActualStatus: Mostrará la Fase 1, 2, 3 o 4 activa -->
                                                    <TextBlock x:Name="TxtFotoActualStatus" 
                                                               Text="Esperando inicio de carga..." 
                                                               FontWeight="SemiBold" 
                                                               Foreground="#A1A1AA" 
                                                               DockPanel.Dock="Left"
                                                               FontSize="12"/>
                                                    <!-- TxtPorcentajeNumStatus: Mostrará el avance exacto (0% al 100%) -->
                                                    <TextBlock x:Name="TxtPorcentajeNumStatus" 
                                                               Text="0%" 
                                                               FontWeight="Bold" 
                                                               Foreground="#007ACC" 
                                                               DockPanel.Dock="Right"
                                                               FontSize="12"/>
                                                </DockPanel>

                                                <!-- CONTENEDOR PREMIUM DE LA BARRA AZUL -->
                                                <Border x:Name="FondoCanalProgreso" 
                                                        Height="14" 
                                                        Background="#151515" 
                                                        CornerRadius="6" 
                                                        ClipToBounds="True">
                                                    <Grid HorizontalAlignment="Left">
                                                        <!-- Esta es la franja física que se estira dinámicamente según la fase matemática -->
                                                        <Border x:Name="RellenoAzulProgreso" 
                                                                Background="#007ACC" 
                                                                Width="0" 
                                                                Height="14" 
                                                                CornerRadius="6"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <!-- 💾 BOTÓN MAESTRO DE INICIALIZACIÓN -->
                                            <Button x:Name="BtnGuardarColegioCompleto"
                                                    Grid.Column="1"
                                                    Content="💾 GUARDAR COLEGIO"
                                                    Padding="12,8"
                                                    MinWidth="160"
                                                    FontSize="12"
                                                    FontWeight="Bold" 
                                                    Height="34"
                                                    VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#0056b3"/>
                                                        <Setter Property="Foreground" Value="#E6F0FA"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                                            CornerRadius="6"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Background" Value="#2D2D30"/>
                                                                <Setter Property="Foreground" Value="#555555"/>
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>
                            
                            <!-- SUB-PESTAÑA 2: EDITAR COLEGIO (DISEÑO CON CABECERA COMPLETA OSCURA) -->
                            <TabItem Header="✏️ Editar Colegio">
                                <Grid Background="{StaticResource FondoMesa}"> <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- 1. Selector y Botón Cargar -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- 2. Banner Institución Seleccionada -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- 3. Búferes Superiores de Fotos Extra -->
                                        <RowDefinition Height="*"/>
                                        <!-- 4. DataGrid de Producción -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- 5. Botonera Inferior -->
                                    </Grid.RowDefinitions>

                                    <!-- 1. SELECCIONA EL COLEGIO A EDITAR Y BOTÓN CARGAR -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,15,20,5">
                                        <TextBlock Text="Selecciona el colegio a editar:" Foreground="{StaticResource TextoPrincipal}" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold" FontSize="12"/>
                                        <ComboBox x:Name="CboEditarColegiosLista" Width="400" Background="#2D2D30" Foreground="White" BorderBrush="{StaticResource BordeContenedor}" Height="28" VerticalContentAlignment="Center" DisplayMemberPath="NombreColegio"/>
                                        <Button x:Name="BtnCargarColegioEdicion" Content="🔹 Cargar Colegio" Foreground="White" Padding="15,0" Height="28" Margin="12,0,0,0" FontWeight="Bold" FontSize="11" BorderThickness="0" Click="BtnCargarColegioEdicion_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <!-- 🟢 CORREGIDO: Inyectamos las curvas de 4px directamente en el hardware visual -->
                                                    <Border Background="#007ACC" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        
                                        <!-- 🔗 TEXTO CON INTELIGENCIA DE ESTADO BASE (CORREGIDO) -->
                                        <TextBlock Text="🔗 Link del Padre:" Foreground="{StaticResource TextoSecundario}" VerticalAlignment="Center" Margin="25,0,8,0" FontSize="12" FontWeight="SemiBold"/>

                                        <TextBlock VerticalAlignment="Center" FontSize="12" Margin="5,0,0,0">
                                            <Hyperlink x:Name="LinkWebPadre" Foreground="#666666" TextDecorations="None" Cursor="Arrow" Click="LinkWebPadre_Click">
                                                <!-- 🟢 Modificamos el texto inicial a tu sugerencia y arrancamos en gris seguro -->
                                                <Run x:Name="TxtLinkVisual" Text="Escoja un colegio y presione cargar para generar el link..."/>
                                            </Hyperlink>
                                        </TextBlock>

                                        <!-- 🔓 BOTÓN DE REVERSIÓN DINÁMICA DE ALTA SEGURIDAD -->
                                        <Button x:Name="BtnHabilitarFamiliarEdicion" 
                                                Content="🔓 Habilitar Fotos Familiares" 
                                                Background="{StaticResource VerdeExito}" 
                                                Foreground="White" 
                                                Padding="15,0" 
                                                Height="28" 
                                                Margin="20,0,0,0" 
                                                FontWeight="Bold" 
                                                FontSize="11" 
                                                BorderThickness="0" 
                                                Visibility="Collapsed" 
                                                Click="BtnHabilitarFamiliarEdicion_Click"/>
                                    </StackPanel>

                                    <!-- 2. BANNER INFORMATIVO: INSTITUCIÓN SELECCIONADA -->
                                    <Border Grid.Row="1" Background="#1A2433" BorderBrush="#2B3D54" BorderThickness="1" CornerRadius="4" Padding="12" Margin="20,8,20,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="INSTITUCIÓN SELECCIONADA" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtInstitucionSeleccionadaBanner" Text="NINGÚN COLEGIO SELECCIONADO" Foreground="#63B3ED" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. CONTENEDORES SUPERIORES DE ADICIÓN FOTOGRÁFICA -->
                                    <Grid Grid.Row="2" Margin="20,4,20,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Carga de Rostros Adicionales -->
                                        <Border Grid.Column="0" Background="#1A1A1C" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📷 Fotos de Rostros Extra: " Foreground="{StaticResource TextoPrincipal}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button x:Name="BtnCargarMasRostros" Content="Elegir archivos..." Foreground="White" Padding="10,0" Height="24" FontWeight="Bold" FontSize="11" BorderThickness="0" Click="BtnCargarMasRostros_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <!-- 🟢 CORREGIDO: Redondeado con el color gris oscuro de tus botones de control -->
                                                            <Border Background="#3E3E42" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock x:Name="TxtStatusMasRostros" Text="Ninguno" Foreground="{StaticResource TextoSecundario}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Carga de Familiares Adicionales -->
                                        <Border Grid.Column="1" Background="#1A1A1C" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👨‍👩‍👧 Fotos Familiares Extra: " Foreground="{StaticResource TextoPrincipal}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button x:Name="BtnCargarMasFamiliares" Content="Elegir archivos..." Foreground="White" Padding="10,0" Height="24" FontWeight="Bold" FontSize="11" BorderThickness="0" Click="BtnCargarMasFamiliares_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <!-- 🟢 CORREGIDO: Redondeado con el color gris oscuro de tus botones de control -->
                                                            <Border Background="#3E3E42" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock x:Name="TxtStatusMasFamiliares" Text="Ninguno" Foreground="{StaticResource TextoSecundario}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 4. DATA GRID DE REESCRITURA COMPLETA -->
                                    <DataGrid Grid.Row="3" x:Name="GridEdicionColegio" Margin="20,0,20,10" 
                                            Background="{StaticResource FondoPanel}" 
                                            RowBackground="#2D2D30" 
                                            AlternatingRowBackground="#252526" 
                                            Foreground="{StaticResource TextoPrincipal}" 
                                            BorderBrush="{StaticResource BordeContenedor}" 
                                            BorderThickness="1" 
                                            AutoGenerateColumns="False" 
                                            HeadersVisibility="Column" 
                                            GridLinesVisibility="All" 
                                            HorizontalGridLinesBrush="#3F3F46" 
                                            VerticalGridLinesBrush="#3F3F46"
                                            ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            RowHeight="120"
                                            CanUserAddRows="False"
                                            VirtualizingStackPanel.IsVirtualizing="True"
                                            VirtualizingStackPanel.VirtualizationMode="Standard"
                                            EnableRowVirtualization="False"
                                            PreparingCellForEdit="GridEdicionColegio_PreparingCellForEdit">

                                        <!-- Bloque de Transparencia inyectado de forma segura -->
                                        <DataGrid.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{Binding Foreground.Color, ElementName=GridEdicionColegio}"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{Binding Foreground.Color, ElementName=GridEdicionColegio}"/>

                                            <!-- 🎨 1. ESTILO DE LECTURA (ESTÁTICO VINCULADO) -->
                                            <Style x:Key="TextoCentradoFilaAlta" TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="5,0"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </Style>

                                            <Style x:Key="NombreCentradoVertical" TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Setter Property="Padding" Value="10,0"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>

                                            <!-- 🎨 2. 🔒 EL CANDADO DE EDICIÓN MODO OSCURO (Fuerza fondo oscuro y centrado al escribir) -->
                                            <Style x:Key="CeldaEditorOscuroCentrado" TargetType="TextBox">
                                                <Setter Property="Background" Value="#2D2D30"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#007ACC"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="5,0"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="CaretBrush" Value="White"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <!-- Centra el texto horizontalmente para las columnas compactas -->
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>

                                            <!-- Estilo de edición específico para el Nombre Completo (Alineado a la izquierda) -->
                                            <Style x:Key="CeldaEditorNombreOscuro" TargetType="TextBox" BasedOn="{StaticResource CeldaEditorOscuroCentrado}">
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                <Setter Property="Padding" Value="10,0"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </Style>
                                        </DataGrid.Resources>

                                        <DataGrid.Columns>
                                            <!-- 🔢 1. N° ORDEN CON INDICADOR CELESTE DE EDICIÓN ACTIVA -->
                                            <DataGridTemplateColumn Header="N° Orden" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- Malla transparente que pega el filete al extremo izquierdo exacto -->
                                                        <Grid Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 📱 LÍNEA VERTICAL CELESTE FUERTE INDUSTRIAL (Espesor 4px) -->
                                                            <Border Grid.Column="0" 
                                                                    Width="4" 
                                                                    Background="#00D2FF" 
                                                                    Margin="0,1,6,1"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Stretch">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <!-- Si la fila está marcada en edición activa, se enciende por hardware -->
                                                                            <DataTrigger Binding="{Binding EstaSiendoEditadoLocal}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>

                                                            <!-- Número de orden ordinario centrado de tu suite -->
                                                            <TextBlock Grid.Column="1" 
                                                                       Text="{Binding NumeroOrden}" 
                                                                       Style="{StaticResource TextoCentradoFilaAlta}"
                                                                       VerticalAlignment="Center" 
                                                                       HorizontalAlignment="Center" 
                                                                       FontWeight="Bold"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            
                                            <!-- 2. Nombre Completo (Edición Oscura e Izquierda) -->
                                            <DataGridTextColumn Header="Nombre Completo" Width="1.2*" Binding="{Binding NombreCompleto}" 
                                                                ElementStyle="{StaticResource NombreCentradoVertical}"
                                                                EditingElementStyle="{StaticResource CeldaEditorNombreOscuro}"/>

                                            <!-- 3. Fecha Nacimiento (REPLICACIÓN PHP CORREGIDA Y ALINEADA ANTI-BLOQUEO) -->
                                            <DataGridTemplateColumn Header="Fecha Nac." Width="150">
                                                <!-- VISTA REPOSO: Muestra la fecha limpia o dd/mm/aaaa sin desalinearse -->
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Background="Transparent" Margin="10,0,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Texto formateado o marcador de posición -->
                                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding FechaNacimiento, StringFormat=\{0:dd/MM/yyyy\}}"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FechaNacimiento}" Value="{x:Null}">
                                                                                <Setter Property="Text" Value="dd/mm/aaaa"/>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            
                                                            <DatePicker Grid.Column="1"
                                                                        SelectedDate="{Binding FechaNacimiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        BorderThickness="0"
                                                                        Background="Transparent"
                                                                        VerticalAlignment="Center"
                                                                        Width="30"
                                                                        Focusable="False">
                                                                <DatePicker.Resources>
                                                                    <Style TargetType="DatePickerTextBox">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Setter Property="Opacity" Value="0"/>
                                                                        <Setter Property="Width" Value="0"/>
                                                                    </Style>
                                                                </DatePicker.Resources>
                                                            </DatePicker>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>

                                                <!-- VISTA EDICIÓN: Activa los 3 bloques alineados listos para el teclado -->
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <Grid Background="#2D2D30" Margin="5,0,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Grilla interna de 5 columnas para alinear perfectamente los bloques y barras -->
                                                            <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20"/>
                                                                    <!-- dd -->
                                                                    <ColumnDefinition Width="8"/>
                                                                    <!-- /  -->
                                                                    <ColumnDefinition Width="20"/>
                                                                    <!-- mm -->
                                                                    <ColumnDefinition Width="8"/>
                                                                    <!-- /  -->
                                                                    <ColumnDefinition Width="35"/>
                                                                    <!-- aaaa -->
                                                                </Grid.ColumnDefinitions>

                                                                <TextBox Grid.Column="0" x:Name="TxtDia" 
                                                                         Text="{Binding SurfaceDia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                         MaxLength="2" Background="Transparent" Foreground="White" BorderThickness="0" 
                                                                         FontSize="13" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                         GotFocus="TextBoxBloque_GotFocus" TextChanged="TxtDia_TextChanged"/>

                                                                <TextBlock Grid.Column="1" Text="/" Foreground="White" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                                <TextBox Grid.Column="2" x:Name="TxtMes" 
                                                                         Text="{Binding SurfaceMes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                         MaxLength="2" Background="Transparent" Foreground="White" BorderThickness="0" 
                                                                         FontSize="13" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                         GotFocus="TextBoxBloque_GotFocus" TextChanged="TxtMes_TextChanged"/>

                                                                <TextBlock Grid.Column="3" Text="/" Foreground="White" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                                <TextBox Grid.Column="4" x:Name="TxtAnio" 
                                                                         Text="{Binding SurfaceAnio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                         MaxLength="4" Background="Transparent" Foreground="White" BorderThickness="0" 
                                                                         FontSize="13" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                         GotFocus="TextBoxBloque_GotFocus"/>
                                                            </Grid>

                                                            <!-- El DatePicker en modo edición para sincronizar el ratón -->
                                                            <DatePicker Grid.Column="1"
                                                                        SelectedDate="{Binding FechaNacimiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        BorderThickness="0"
                                                                        Background="Transparent"
                                                                        VerticalAlignment="Center"
                                                                        Width="30">
                                                                <DatePicker.Resources>
                                                                    <Style TargetType="DatePickerTextBox">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Setter Property="Opacity" Value="0"/>
                                                                        <Setter Property="Width" Value="0"/>
                                                                    </Style>
                                                                </DatePicker.Resources>
                                                            </DatePicker>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 4. Sexo (Mantiene su ComboBox Oscuro Independiente) -->
                                            <DataGridTemplateColumn Header="Sexo" Width="105">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- 🟢 CORREGIDO: Añadimos el evento SelectionChanged para capturar el clic del operador -->
                                                        <ComboBox SelectedValue="{Binding Sexo, Converter={StaticResource ConvertidorSexoNull}, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Content"
                                                                  SelectionChanged="ComboBoxSexo_SelectionChanged"
                                                                  Height="24"
                                                                  Width="95"
                                                                  HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"
                                                                  Background="#2D2D30" 
                                                                  Foreground="White">
                                                            <ComboBoxItem Content="-- Elige --" Background="#252526" Foreground="#666666"/>
                                                            <ComboBoxItem Content="Masculino" Background="#252526" Foreground="White"/>
                                                            <ComboBoxItem Content="Femenino" Background="#252526" Foreground="White"/>
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <!-- 5. Hobbies (Edición Oscura Centrada) -->
                                            <DataGridTextColumn Header="Hobbies" Width="1.2*" Binding="{Binding Hobbies}" 
                                                                ElementStyle="{StaticResource TextoCentradoFilaAlta}"
                                                                EditingElementStyle="{StaticResource CeldaEditorOscuroCentrado}"/>

                                            <!-- 6. Comida Fav. (Edición Oscura Centrada) -->
                                            <DataGridTextColumn Header="Comida Fav." Width="1.2*" Binding="{Binding ComidaFav}" 
                                                                ElementStyle="{StaticResource TextoCentradoFilaAlta}"
                                                                EditingElementStyle="{StaticResource CeldaEditorOscuroCentrado}"/>

                                            <!-- 7. Profesión (Edición Oscura Centrada) -->
                                            <DataGridTextColumn Header="Profesión" Width="1.2*" Binding="{Binding Profesion}" 
                                                                ElementStyle="{StaticResource TextoCentradoFilaAlta}"
                                                                EditingElementStyle="{StaticResource CeldaEditorOscuroCentrado}"/>

                                            <!-- 👤 COLUMNA FOTO ROSTRO: REGLA DE CONMUTACIÓN DE CARTEL UNIFICADO -->
                                            <DataGridTemplateColumn Header="Foto Alumno" Width="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="85"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- ZONA SUPERIOR: CAMBIA EL CARTEL SEGÚN LA BASE DE DATOS -->
                                                            <!-- A. 🖼️ Imagen Normal (Solo visible si hay foto real válida) -->
                                                            <Border x:Name="ImgRostroNormal" Grid.Row="0" CornerRadius="6" Background="#1E1E1C" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1" Height="80" Width="114" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Grid Background="#1E1E1C">
                                                                    <Grid.OpacityMask>
                                                                        <VisualBrush Visual="{Binding ElementName=ClipMoldRostro}"/>
                                                                    </Grid.OpacityMask>
                                                                    <Border x:Name="ClipMoldRostro" Background="#1E1E1C" CornerRadius="6"/>
                                                                    <Image Source="{Binding RutaFotoRostro, Converter={StaticResource RotadorExifAutomatizado}}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>

                                                            <!-- B. ⏳ Cartel de Pendiente (Si el campo está vacío o es 'Ninguna') -->
                                                            <Border x:Name="CartelPendienteRostro" Grid.Row="0" CornerRadius="6" Background="#1E1E1C" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1" Height="80" Width="114" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="Pendiente" Foreground="#666666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- C. 🚨 Cartel de Emergencia (Si el campo dice literalmente 'emergencia') -->
                                                            <Border x:Name="CartelEmergenciaRostro" Grid.Row="0" CornerRadius="6" Background="#2A1B10" BorderBrush="#E65100" BorderThickness="1" Height="80" Width="114" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="🚨" FontSize="18" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="Emergencia" Foreground="#FF9800" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- ZONA INFERIOR: COMBOBOX MAESTRO SIEMPRE VISIBLE POR HARDWARE -->
                                                            <!-- 🔒 TargetNullValue fuerza 'Ninguna' si la base de datos dice 'emergencia' o está vacía -->
                                                            <!-- ⚡ VIRTUALIZACIÓN DE HARDWARE ACTIVA (CORREGIDO v2026) -->
                                                            <ComboBox Grid.Row="1" 
                                                                      IsSynchronizedWithCurrentItem="False"
                                                                      ItemsSource="{Binding DataContext.ListaRostrosDisponibles, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                      SelectedItem="{Binding FotoRostro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='-- Ninguna --', TargetNullValue='-- Ninguna --'}" 
                                                                      SelectionChanged="ComboBoxFoto_SelectionChanged" 
                                                                      Height="24" 
                                                                      VerticalContentAlignment="Center" 
                                                                      Margin="2,2,2,2"
                                                                      VirtualizingPanel.IsVirtualizing="True"
                                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                                      VirtualizingPanel.ScrollUnit="Pixel">

                                                                <!-- Redefinimos el panel interno para usar el contenedor de virtualización fluida -->
                                                                <ComboBox.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <VirtualizingStackPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ComboBox.ItemsPanel>
                                                            </ComboBox>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <!-- CONMUTACIÓN EXCLUSIVA DE COMPORTAMIENTO SUPERIOR -->
                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="">
                                                                <Setter TargetName="ImgRostroNormal" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="CartelPendienteRostro" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="{x:Null}">
                                                                <Setter TargetName="ImgRostroNormal" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="CartelPendienteRostro" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="PENDIENTE">
                                                                <Setter TargetName="ImgRostroNormal" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="CartelPendienteRostro" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="-- Ninguna --">
                                                                <Setter TargetName="ImgRostroNormal" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="CartelPendienteRostro" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>

                                                            <!-- REGLA DE EMERGENCIA: Oculta la foto normal y activa la alerta, pero deja el combo intacto abajo -->
                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="emergencia">
                                                                <Setter TargetName="ImgRostroNormal" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="CartelEmergenciaRostro" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 👨‍👩‍👧 COLUMNA FOTO FAMILIAR: REGLA DE CONMUTACIÓN DE CARTEL UNIFICADO -->
                                            <DataGridTemplateColumn Header="Foto Familiar" Width="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="85"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- ZONA SUPERIOR: CAMBIA EL CARTEL SEGÚN LA BASE DE DATOS -->
                                                            <!-- A. 🖼️ Imagen Normal (Solo visible si hay foto real válida) -->
                                                            <Border x:Name="ImgFamiliarNormal" Grid.Row="0" CornerRadius="6" Background="#1E1E1C" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1" Height="80" Width="114" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Grid Background="#1E1E1C">
                                                                    <Grid.OpacityMask>
                                                                        <VisualBrush Visual="{Binding ElementName=ClipMoldFamiliar}"/>
                                                                    </Grid.OpacityMask>
                                                                    <Border x:Name="ClipMoldFamiliar" Background="#1E1E1C" CornerRadius="6"/>
                                                                    <Image Source="{Binding RutaFotoFamiliar, Converter={StaticResource RotadorExifAutomatizado}}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>

                                                            <!-- B. ⏳ Cartel de Pendiente (Si el campo está vacío o es 'Ninguna') -->
                                                            <Border x:Name="CartelPendienteFamiliar" Grid.Row="0" CornerRadius="6" Background="#1E1E1C" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1" Height="80" Width="114" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="Pendiente" Foreground="#666666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- C. 🚨 Cartel de Emergencia (Si el campo dice literalmente 'emergencia') -->
                                                            <Border x:Name="CartelEmergenciaFamiliar" Grid.Row="0" CornerRadius="6" Background="#2A1B10" BorderBrush="#E65100" BorderThickness="1" Height="80" Width="114" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="🚨" FontSize="18" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="Emergencia" Foreground="#FF9800" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- D. Cartel de Sección Excluida -->
                                                            <Border x:Name="CartelExcluidoFamiliar" Grid.Row="0" CornerRadius="6" Background="#1E1212" BorderBrush="#995555" BorderThickness="1" Height="80" Width="114" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="🚫" FontSize="20" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="Excluido" Foreground="#FF5252" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- ZONA INFERIOR: COMBOBOX MAESTRO SIEMPRE VISIBLE POR HARDWARE -->
                                                            <ComboBox Grid.Row="1" 
                                                                      IsSynchronizedWithCurrentItem="False"
                                                                      ItemsSource="{Binding DataContext.ListaFamiliaresDisponibles, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                                      SelectedItem="{Binding FotoFamiliar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='-- Ninguna --', TargetNullValue='-- Ninguna --'}" 
                                                                      SelectionChanged="ComboBoxFoto_SelectionChanged" 
                                                                      Height="24" 
                                                                      VerticalContentAlignment="Center" 
                                                                      Margin="2,2,2,2"
                                                                      VirtualizingPanel.IsVirtualizing="True"
                                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                                      VirtualizingPanel.ScrollUnit="Pixel">
                                                                <ComboBox.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <VirtualizingStackPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ComboBox.ItemsPanel>
                                                            </ComboBox>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <!-- CONMUTACIÓN EXCLUSIVA DE COMPORTAMIENTO SUPERIOR -->
                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="">
                                                                <Setter TargetName="ImgFamiliarNormal" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="CartelPendienteFamiliar" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="{x:Null}">
                                                                <Setter TargetName="ImgFamiliarNormal" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="CartelPendienteFamiliar" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="PENDIENTE">
                                                                <Setter TargetName="ImgFamiliarNormal" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="CartelPendienteFamiliar" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="-- Ninguna --">
                                                                <Setter TargetName="ImgFamiliarNormal" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="CartelPendienteFamiliar" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>

                                                            <!-- REGLA DE EMERGENCIA: Oculta la foto normal y activa la alerta, pero deja el combo intacto abajo -->
                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="emergencia">
                                                                <Setter TargetName="ImgFamiliarNormal" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="CartelEmergenciaFamiliar" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="DESACTIVADO">
                                                                <Setter TargetName="ImgFamiliarNormal" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="CartelExcluidoFamiliar" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 10. Permiso / Fila (Estado + Botones con Bordes Redondeados) -->
                                            <DataGridTemplateColumn Header="Permiso / Fila" Width="155">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" Margin="5,2,5,2">
                                                            <TextBlock Text="{Binding TextoEstadoWeb}" Foreground="{Binding ColorEstadoWeb}" 
                                                                        FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <Button Content="{Binding TextoBotonPermiso}" 
                                                                    Click="BtnCambiarEstadoAcceso_Click"
                                                                    Background="{Binding ColorBotonPermiso}" Foreground="White"
                                                                    FontSize="11" Padding="5,2,5,2" Height="24" Margin="0,0,0,4">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="4"/>
                                                                    </Style>
                                                                </Button.Resources>
                                                            </Button>
                                                            <Button Content="Eliminar ✖" 
                                                                    Click="BtnEliminarFila_Click"
                                                                    Background="#DC3545" Foreground="White" 
                                                                    FontSize="11" Padding="5,2,5,2" Height="22">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="4"/>
                                                                    </Style>
                                                                </Button.Resources>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- 5. BARRA DE CONTROL OSCURA INFERIOR REESTRUCTURADA CON BARRA AZUL -->
                                    <Border Grid.Row="4" Background="#1A1A1A" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="0,1,0,0" Padding="20,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Botón Añadir -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Espacio Central para la Barra Azul -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Botón Aplicar -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Botón Añadir Alumno (Columna 0) -->
                                            <Button x:Name="BtnAnadirFilaEdicion" Content="＋ Añadir Alumno" Foreground="White" Padding="15,0" Height="30" FontWeight="Bold" FontSize="11" BorderThickness="0" Click="BtnAnadirFilaEdicion_Click" HorizontalAlignment="Left" Margin="20,0,0,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <!-- 🟢 CORREGIDO: Curvas de 4px aplicadas con tu nombre real BtnAnadirFilaEdicion -->
                                                        <Border Background="#27AE60" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- 📊 PANEL DE PROGRESO AZUL EN VIVO (Columna 1 - Integrado de forma quirúrgica) -->
                                            <StackPanel Grid.Column="1" Margin="25,0,25,0" VerticalAlignment="Center">
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock x:Name="TxtFotoActualStatusEdicion" 
                                                               Text="Esperando para actualizar registros..." 
                                                               FontWeight="SemiBold" 
                                                               Foreground="#636363" 
                                                               HorizontalAlignment="Left"
                                                               FontSize="11"/>
                                                    <TextBlock x:Name="TxtPorcentajeNumStatusEdicion" 
                                                               Text="0%" 
                                                               FontWeight="Bold" 
                                                               Foreground="#007ACC" 
                                                               HorizontalAlignment="Right"
                                                               FontSize="11"/>
                                                </Grid>

                                                <!-- Contenedor simulado idéntico a tu módulo de ingreso -->
                                                <Border x:Name="FondoCanalProgresoEdicion" 
                                                        Height="10" 
                                                        Background="#151515" 
                                                        CornerRadius="5" 
                                                        ClipToBounds="True">
                                                    <Grid HorizontalAlignment="Left">
                                                        <!-- Esta es la franja física que se pintará de azul brillante al actualizar -->
                                                        <Border x:Name="RellenoAzulProgresoEdicion" 
                                                                Background="#007ACC" 
                                                                Width="0" 
                                                                Height="10" 
                                                                CornerRadius="5"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <!-- Botón Aplicar Cambios Maestros (Columna 2) -->
                                            <Button Grid.Column="2" 
                                                    x:Name="BtnAplicarCambiosMaestros" 
                                                    Content="💾 ACTUALIZAR Y APLICAR CAMBIOS" 
                                                    Foreground="White" 
                                                    Padding="30,8" 
                                                    FontSize="12" 
                                                    FontWeight="Bold" 
                                                    HorizontalAlignment="Right" 
                                                    BorderThickness="0" 
                                                    Click="BtnAplicarCambiosMaestros_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <!-- 🟢 CORREGIDO: Curvas de 4px heredando dinámicamente tu recurso AzulAcento -->
                                                        <Border Background="{StaticResource AzulAcento}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>


                                    <!-- ⏳ INDICADOR INDUSTRIAL DE CARGA FLOTANTE (Sin botones, autogestionado) -->
                                    <Border x:Name="PanelCargandoEdicion" 
                                            Grid.Row="1" Grid.RowSpan="3"
                                            Background="#B0101010" 
                                            CornerRadius="6"
                                            Visibility="Collapsed"
                                            Panel.ZIndex="999">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Texto con estética premium de Modo Oscuro -->
                                            <TextBlock Text="Cargando colegio..." 
                                                       Foreground="{StaticResource TextoPrincipal}" 
                                                       FontSize="18" 
                                                       FontWeight="Bold" 
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,10"/>
                                            <!-- Pequeña barra o texto de progreso continuo de espera -->
                                            <TextBlock Text="⏳ Sincronizando con los canales de StackCP..." 
                                                       Foreground="{StaticResource TextoSecundario}" 
                                                       FontSize="12" 
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- SUB-PESTAÑA 3: ELIMINAR COLEGIO (DISEÑO SEGURO MODO OSCURO) -->
                            <TabItem Header="🗑️ Eliminar Colegio">
                                <Grid Background="{StaticResource FondoMesa}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- 1. Selector y Botón Buscar -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- 2. Banner Institución Objetivo -->
                                        <RowDefinition Height="*"/>
                                        <!-- 3. Zona de Advertencia Central -->
                                    </Grid.RowDefinitions>

                                    <!-- 1. SELECCIONA EL COLEGIO A REMOVER -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,15,20,5">
                                        <TextBlock Text="Selecciona el colegio a eliminar:" Foreground="{StaticResource TextoPrincipal}" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold" FontSize="12"/>
                                        <ComboBox x:Name="CboEliminarColegiosLista" 
                                                   Width="400" 
                                                   Background="#2D2D30" 
                                                   Foreground="White" 
                                                   BorderBrush="{StaticResource BordeContenedor}" 
                                                   Height="28" 
                                                   VerticalContentAlignment="Center"
                                                   DisplayMemberPath="NombreColegio"/>
                                        <Button x:Name="BtnCargarColegioEliminar" Content="🔍 Verificar Colegio" Background="#3E3E42" Foreground="White" Padding="15,0" Height="28" Margin="12,0,0,0" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Click="BtnCargarColegioEliminar_Click"/>
                                    </StackPanel>

                                    <!-- 2. BANNER INFORMATIVO DE RIESGO DE DESTRUCCIÓN -->
                                    <Border Grid.Row="1" Background="#2B1A1A" BorderBrush="#542B2B" BorderThickness="1" CornerRadius="4" Padding="12" Margin="20,8,20,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="COLEGIO PROBABLE A SER REMOVIDO" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtInstitucionEliminarBanner" Text="NINGÚN COLEGIO SELECCIONADO" Foreground="#F44336" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. ZONA DE DESTRUCCIÓN CRÍTICA -->
                                    <Border Grid.Row="2" Background="{StaticResource FondoPanel}" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1" CornerRadius="6" Margin="20,5,20,20" Padding="30">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="⚠ ZONA DE DESTRUCCIÓN CRÍTICA DE COLEGIOS ⚠" Foreground="{StaticResource RojoPeligro}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                                            <TextBlock Text="Al ejecutar la eliminación estructural del colegio:" Foreground="{StaticResource TextoPrincipal}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,5" FontWeight="SemiBold"/>

                                            <BulletDecorator Margin="40,0,0,15" HorizontalAlignment="Center">
                                                <BulletDecorator.Bullet>
                                                    <TextBlock Text="• " Foreground="{StaticResource TextoSecundario}"/>
                                                </BulletDecorator.Bullet>
                                                <TextBlock Text="Se purgarán de forma permanente todos los alumnos indexados en la base de datos remota." Foreground="{StaticResource TextoSecundario}" FontSize="12"/>
                                            </BulletDecorator>

                                            <BulletDecorator Margin="40,0,0,25" HorizontalAlignment="Center">
                                                <BulletDecorator.Bullet>
                                                    <TextBlock Text="• " Foreground="{StaticResource TextoSecundario}"/>
                                                </BulletDecorator.Bullet>
                                                <TextBlock Text="Se romperán los candados y accesos de los padres en la web." Foreground="{StaticResource TextoSecundario}" FontSize="12"/>
                                            </BulletDecorator>

                                            <Button x:Name="BtnDestruirColegio" Content="💣 DESTRUIR REGISTROS DE COLEGIO EN LA NUBE" Background="{StaticResource RojoPeligro}" Foreground="White" Padding="30,12" FontSize="13" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Center" Click="BtnDestruirColegio_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- SUB-PESTAÑA 4: REPORTE DE ELECCIONES (AUDITORÍA COMPLETA MODO OSCURO) -->
                            <TabItem Header="📋 Reporte de Elecciones">
                                <Grid Background="{StaticResource FondoMesa}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- 1. Selector y Generar Reporte -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- 2. Banner de Descarga Excel -->
                                        <RowDefinition Height="*"/>
                                        <!-- 3. DataGrid de Auditoría Real -->
                                    </Grid.RowDefinitions>

                                    <!-- 1. BARRA SUPERIOR DE FILTRO -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,15,20,5">
                                        <TextBlock Text="Selecciona la Institución para ver Resultados:" Foreground="{StaticResource TextoPrincipal}" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold" FontSize="12"/>
                                        <ComboBox x:Name="CboReporteColegiosLista" Width="400" Background="#2D2D30" Foreground="White" BorderBrush="{StaticResource BordeContenedor}" Height="28" VerticalContentAlignment="Center"/>
                                        <Button x:Name="BtnGenerarReporte" Content="🔹 Generar Reporte" Background="{StaticResource AzulAcento}" Foreground="White" Padding="15,0" Height="28" Margin="12,0,0,0" FontWeight="Bold" FontSize="11" BorderThickness="0" Click="BtnGenerarReporte_Click"/>
                                    </StackPanel>

                                    <!-- 2. ACCIÓN DE DESCARGA (Estilo Botón Verde de tu Web) -->
                                    <Grid Grid.Row="1" Margin="20,5,20,10">
                                        <Button x:Name="BtnExportarExcelAdministrativo" Content="📥 Descargar Reporte en Excel (.xlsx)" Background="{StaticResource VerdeExito}" Foreground="White" Padding="20,6" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" BorderThickness="0" Click="BtnExportarExcelAdministrativo_Click"/>
                                    </Grid>

                                    <!-- 3. DATA GRID DE AUDITORÍA MASIVA CON COLUMNAS EXACTAS (CORREGIDO) -->
                                    <DataGrid Grid.Row="2" x:Name="GridReporteElecciones" Margin="20,0,20,20" 
                                              Background="{StaticResource FondoPanel}" 
                                              RowBackground="#2D2D30" 
                                              AlternatingRowBackground="#252526" 
                                              Foreground="{StaticResource TextoPrincipal}" 
                                              BorderBrush="{StaticResource BordeContenedor}" 
                                              BorderThickness="1" 
                                              IsReadOnly="True" 
                                              AutoGenerateColumns="False" 
                                              HeadersVisibility="Column" 
                                              GridLinesVisibility="All" 
                                              HorizontalGridLinesBrush="#3F3F46" 
                                              VerticalGridLinesBrush="#3F3F46"
                                              FontSize="13"
                                              RowHeight="36">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="N° Orden" Width="80" Binding="{Binding NumeroOrden}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="Nombre Completo del Alumno" Width="250" Binding="{Binding NombreCompleto}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Padding" Value="8,0,0,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- 📅 COLUMNA FECHA NACIMIENTO CON GUION DE RESPALDO -->
                                            <DataGridTemplateColumn Header="Fecha Nac." Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding FechaNacimiento, StringFormat=\{0:dd/MM/yyyy\}}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FechaNacimiento}" Value="{x:Null}">
                                                                            <Setter Property="Text" Value="-"/>
                                                                            <Setter Property="Foreground" Value="#555555"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 🚻 COLUMNA SEXO CON GUION DE RESPALDO -->
                                            <DataGridTemplateColumn Header="Sexo" Width="95">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding Sexo}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Sexo}" Value="">
                                                                            <Setter Property="Text" Value="-"/>
                                                                            <Setter Property="Foreground" Value="#555555"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Sexo}" Value="{x:Null}">
                                                                            <Setter Property="Text" Value="-"/>
                                                                            <Setter Property="Foreground" Value="#555555"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Sexo}" Value="-- Elige --">
                                                                            <Setter Property="Text" Value="-"/>
                                                                            <Setter Property="Foreground" Value="#555555"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Sexo}" Value="-">
                                                                            <Setter Property="Text" Value="-"/>
                                                                            <Setter Property="Foreground" Value="#555555"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 📝 COLUMNA PREFERENCIAS / RESPUESTAS CON GUION DE RESPALDO -->
                                            <DataGridTemplateColumn Header="Preferencias / Respuestas" Width="280">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid VerticalAlignment="Center" Margin="6,2">
                                                            <!-- Bloque de contenido: Solo visible si Hobbies contiene datos reales -->
                                                            <StackPanel x:Name="ContenedorRespuestas">
                                                                <TextBlock Text="{Binding Hobbies}" Foreground="#FFB300" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding ComidaFav}" Foreground="{StaticResource TextoPrincipal}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                            </StackPanel>

                                                            <!-- Guion de respaldo: Solo visible si está vacío o nulo -->
                                                            <TextBlock x:Name="TxtGuionPreferencias" Text="-000" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555555" Visibility="Collapsed"/>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <!-- Si el campo Hobbies viene vacío de la base de datos, conmutamos los controles visuales -->
                                                            <DataTrigger Binding="{Binding Hobbies}" Value="">
                                                                <Setter TargetName="ContenedorRespuestas" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="TxtGuionPreferencias" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="TxtGuionPreferencias" Property="Text" Value="-"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Hobbies}" Value="{x:Null}">
                                                                <Setter TargetName="ContenedorRespuestas" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="TxtGuionPreferencias" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="TxtGuionPreferencias" Property="Text" Value="-"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 👤 COLUMNA ROSTRO ELEGIDO PREMIUM (CON CARTEL DE EMERGENCIA) -->
                                            <DataGridTemplateColumn Header="Rostro Elegido" Width="145">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <!-- 1. TEXTO DEL ARCHIVO REAL: Solo visible si hay una foto asignada -->
                                                            <TextBlock Text="{Binding FotoRostro}" Foreground="{StaticResource TextoPrincipal}" FontSize="12" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="PENDIENTE">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="-- Ninguna --">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="emergencia">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- 2. CARTEL DE PENDIENTE ESTÁNDAR ⏳ -->
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="PENDIENTE">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="-- Ninguna --">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Text="⏳" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Pendiente" Foreground="#666666" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <!-- 3. 🚨 NUEVA ETIQUETA NARANJA DE EMERGENCIA PREMIUM -->
                                                            <Border CornerRadius="4" Padding="6,3" Background="#2A1B10" BorderBrush="#E65100" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FotoRostro}" Value="emergencia">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="🚨" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Emergencia" Foreground="#FF9800" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 👨‍👩‍👧 COLUMNA FOTO FAMILIAR ELEGIDA PREMIUM (CON CARTEL DE EMERGENCIA) -->
                                            <DataGridTemplateColumn Header="Foto Familiar Elegida" Width="145">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <!-- 1. TEXTO DEL ARCHIVO REAL: Solo visible si hay foto real asignada -->
                                                            <TextBlock Text="{Binding FotoFamiliar}" Foreground="{StaticResource TextoPrincipal}" FontSize="12" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="PENDIENTE">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="-- Ninguna --">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="DESACTIVADO">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="emergencia">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- 2. CARTEL DE PENDIENTE ESTÁNDAR ⏳ -->
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="PENDIENTE">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="-- Ninguna --">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Text="⏳" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Pendiente" Foreground="#666666" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <!-- 3. 🚨 NUEVA ETIQUETA NARANJA DE EMERGENCIA PREMIUM -->
                                                            <Border CornerRadius="4" Padding="6,3" Background="#2A1B10" BorderBrush="#E65100" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="emergencia">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="🚨" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Emergencia" Foreground="#FF9800" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- 4. CARTEL DE EXCLUSIÓN ROJO 🚫 -->
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FotoFamiliar}" Value="DESACTIVADO">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Text="🚫" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Excluido" Foreground="#995555" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
                <!-- ========================================================== -->
                <!-- 2° MÓDULO PRINCIPAL: MOTOR DE IA (PASOS VISUALES 1-4)      -->
                <!-- ========================================================== -->
                <TabItem Header="🤖 Motor de IA (Pasos 1-4)">
                    <Grid Background="{StaticResource FondoOscuro}">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- CONTENEDOR EN REJILLA DE LOS 4 PASOS DEL PIPELINE -->
                            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,15">
                                <!-- PASO 1: CLASIFICACIÓN CUÁDRUPLE DE LOTES -->
                                <Border Background="#2D2D30" Margin="0,0,10,0" Padding="12" CornerRadius="6" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="PASO 1" Foreground="{StaticResource AzulAcento}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Clasificación de Lotes" Foreground="{StaticResource TextoPrincipal}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Border Background="#1A365D" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                            <TextBlock Text="📁 Rostro | Familiar | Evento | Basura" Foreground="#63B3ED" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- PASO 2 & 3: CRIBA DE POSES INDIVIDUALES Y FAMILIARES -->
                                <Border Background="#2D2D30" Margin="0,0,10,0" Padding="12" CornerRadius="6" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="PASO 2 y 3" Foreground="{StaticResource AzulAcento}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Criba y Selección de Ráfagas" Foreground="{StaticResource TextoPrincipal}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="📁 Lote Individual: [Detectada]" Foreground="#007ACC" FontSize="11" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                        <TextBlock Text="📁 Lote Familiar: [Detectada]" Foreground="#007ACC" FontSize="11" Margin="0,2,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- PASO 4: SINCRONIZACIÓN Y EXCEL WEB -->
                                <Border Background="#2D2D30" Margin="0,0,10,0" Padding="12" CornerRadius="6" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="PASO 4" Foreground="{StaticResource AzulAcento}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Fusión e Inyección Excel" Foreground="{StaticResource TextoPrincipal}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <Border Background="#2D2D30" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left">
                                            <TextBlock Text="📥 Sincronizando Pixeleduca" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- PASO FINAL: EMPAQUETADO ESTRUCTURADO -->
                                <Border Background="#2D2D30" Padding="12" CornerRadius="6" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="FINAL" Foreground="{StaticResource AzulAcento}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Empaquetado por Orden" Foreground="{StaticResource TextoPrincipal}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBlock Text="🗂 Creando carpetas (\1\, \2\...)" Foreground="{StaticResource TextoSecundario}" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- BOTONERA DE CONTROL PRINCIPAL offline/online -->
                            <Grid Grid.Row="1" Margin="0,0,0,15">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BotonProcesarLote" Content="⚡ Iniciar Pipeline IA" Background="{StaticResource VerdeExito}" Foreground="White" Padding="20,8" FontWeight="Bold" BorderThickness="0"/>
                                    <Button x:Name="BotonAbortar" Content="🛑 Abortar Proceso" Background="{StaticResource RojoPeligro}" Foreground="White" Padding="15,6" Margin="15,0,0,0" FontWeight="SemiBold" BorderThickness="0"/>
                                </StackPanel>
                                <TextBlock Text="* Operando mediante Vertex AI / Gemini 1.5 Flash local desde hosting web" Foreground="{StaticResource TextoSecundario}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontStyle="Italic"/>
                            </Grid>

                            <!-- CONSOLA DE LOGS INTEGRADA -->
                            <Border Grid.Row="2" Background="{StaticResource FondoPanel}" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1" CornerRadius="6" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="CONSOLA DE OPERACIONES EN VIVO POR IA" Foreground="{StaticResource TextoSecundario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="TxtLogsIA" Text=">>> Motor listo. Presiona 'Iniciar Pipeline IA' para descargar tokens y escanear directorios crudos..." Foreground="#A2E8A2" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- BARRA DE PROGRESO GENERAL -->
                            <ProgressBar Grid.Row="3" x:Name="BarraProgresoIA" Height="10" Value="0" Background="#1E1E1E" Foreground="{StaticResource AzulAcento}" BorderThickness="0" Margin="0,15,0,0"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- ========================================================== -->
                <!-- 3° MÓDULO PRINCIPAL: MESA DE INDEXACIÓN (GRILLA Y RÁFAGAS) -->
                <!-- ========================================================== -->
                <TabItem Header="📊 Mesa de Indexación">
                    <Grid Background="{StaticResource FondoOscuro}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>

                        <!-- PANEL SUPERIOR: GRILLA PRINCIPAL TIPO EXCEL -->
                        <Grid Grid.Row="0" Margin="20,20,20,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38*"/>
                                <RowDefinition Height="405*"/>
                            </Grid.RowDefinitions>

                            <!-- BARRA DE HERRAMIENTAS DE INDEXACIÓN EN CALIENTE -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="BtnAnadirColumna" Content="➕ Añadir Columna de Página" Background="#3E3E42" Foreground="{StaticResource TextoPrincipal}" Padding="12,6" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0"/>
                                <Button x:Name="BtnGuardarAvanceMesa" Content="💾 Guardar Avance" Background="{StaticResource AzulAcento}" Foreground="White" Padding="15,6" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0"/>
                                <Button x:Name="BtnExportarExcelFinal" Content="📊 Exportar Excel Final" Background="{StaticResource VerdeExito}" Foreground="White" Padding="15,6" FontWeight="SemiBold" BorderThickness="0"/>
                                <TextBlock Text="* Lectura directa desde el archivo elecciones_web.xlsx" Foreground="{StaticResource TextoSecundario}" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="11" FontStyle="Italic"/>
                            </StackPanel>

                            <!-- DATA GRID DINÁMICO TIPO HOJA DE CÁLCULO -->
                            <DataGrid x:Name="GridExcel" Grid.Row="1" Background="{StaticResource FondoPanel}" RowBackground="#2D2D30" AlternatingRowBackground="#252526" Foreground="{StaticResource TextoPrincipal}" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="All" HorizontalGridLinesBrush="#3F3F46" VerticalGridLinesBrush="#3F3F46" FrozenColumnCount="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="N° Orden" Width="80" Binding="{Binding numero_orden}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Apellidos y Nombres" Width="280" Binding="{Binding nombre_completo}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Foto Rostro" Width="130" Binding="{Binding foto_rostro_codigo}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Foto Familiar" Width="130" Binding="{Binding foto_familiar_codigo}" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- PANEL INFERIOR: BANCO DE FOTOS POR NÚMERO DE ORDEN -->
                        <Border Grid.Row="1" Background="#151515" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="0,1,0,0" Padding="15" Margin="0,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="BANCO DE IMÁGENES ACTIVO (Lectura en caliente del Alumno seleccionado)" Foreground="{StaticResource TextoSecundario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <!-- Este panel se llena en ráfaga mapeando el disco \Fotos Seleccionadas\ID_ALUMNO -->
                                    <StackPanel Orientation="Horizontal" x:Name="PanelRafagasSimuladas">
                                        <Border Width="110" Margin="0,0,10,0" Background="#2D2D30" CornerRadius="4" BorderBrush="{StaticResource AzulAcento}" BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="📷 Rostro 1" Foreground="{StaticResource TextoPrincipal}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <Border Background="#A1007ACC" VerticalAlignment="Bottom" Height="18">
                                                    <TextBlock Text="DSC_1420.JPG" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Width="110" Margin="0,0,10,0" Background="#2D2D30" CornerRadius="4" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="📷 Rostro 2" Foreground="{StaticResource TextoPrincipal}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <Border Background="#A1007ACC" VerticalAlignment="Bottom" Height="18">
                                                    <TextBlock Text="DSC_1421.JPG" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Width="110" Margin="0,0,10,0" Background="#2D2D30" CornerRadius="4" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="👨‍👩‍👧 Familiar" Foreground="{StaticResource TextoPrincipal}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <Border Background="#A12E7D32" VerticalAlignment="Bottom" Height="18">
                                                    <TextBlock Text="DSC_1590.JPG" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- ========================================================== -->
                <!-- 4° MÓDULO PRINCIPAL: MAPEADOR DE PÁGINAS (DESPACHO PHOTOSHOP)-->
                <!-- ========================================================== -->
                <TabItem Header="🗺️ Mapeador de Páginas">
                    <Grid Background="{StaticResource FondoOscuro}">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- BARRA SUPERIOR DE DESPACHO INDUSTRIAL -->
                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Mapeador de Estructura de Páginas" Foreground="{StaticResource TextoPrincipal}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Vincula los campos relacionales para inyectar hojas en Excel y despachar variables .txt a Photoshop" Foreground="{StaticResource TextoSecundario}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnProcesarMapeo" Content="⚡ Procesar Mapeo y Despachar a Photoshop" Background="{StaticResource AzulAcento}" Foreground="White" Padding="18,8" FontWeight="Bold" HorizontalAlignment="Right" BorderThickness="0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- LIENZO CANVAS DE RELACIONES ESTILO ACCESS -->
                            <Border Grid.Row="1" Background="{StaticResource FondoPanel}" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1" CornerRadius="6">
                                <Canvas x:Name="CanvasMapeador" Background="#111111">
                                    <!-- TABLA ORIGEN: VARIABLES MAESTRAS -->
                                    <Border Canvas.Left="50" Canvas.Top="40" Width="200" Background="#2D2D30" CornerRadius="4" BorderBrush="{StaticResource AzulAcento}" BorderThickness="1">
                                        <StackPanel>
                                            <Border Background="{StaticResource AzulAcento}" Padding="8,4">
                                                <TextBlock Text="Origen: Elecciones Web / RAM" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="🔑 numero_orden" Foreground="#A2E8A2" FontSize="11" Margin="8,4,8,2"/>
                                            <TextBlock Text="👤 nombre_completo" Foreground="{StaticResource TextoPrincipal}" FontSize="11" Margin="8,2"/>
                                            <TextBlock Text="📝 hobbies" Foreground="{StaticResource TextoPrincipal}" FontSize="11" Margin="8,2"/>
                                            <TextBlock Text="🍕 comida_fav" Foreground="{StaticResource TextoPrincipal}" FontSize="11" Margin="8,2"/>
                                            <TextBlock Text="🎓 profesion" Foreground="{StaticResource TextoPrincipal}" FontSize="11" Margin="8,2"/>
                                            <TextBlock Text="🖼️ foto_rostro_codigo" Foreground="{StaticResource TextoPrincipal}" FontSize="11" Margin="8,2"/>
                                            <TextBlock Text="👨‍👩‍👧 foto_familiar_codigo" Foreground="{StaticResource TextoPrincipal}" FontSize="11" Margin="8,2,8,6"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- DESTINO 1: HOJA TAPAS -->
                                    <Border Canvas.Left="380" Canvas.Top="40" Width="180" Background="#2D2D30" CornerRadius="4" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1">
                                        <StackPanel>
                                            <Border Background="#3E3E42" Padding="8,4">
                                                <TextBlock Text="Destino: Hoja_Tapas (.txt)" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="🔗 numero_orden" Foreground="{StaticResource TextoSecundario}" FontSize="11" Margin="8,4,8,2"/>
                                            <TextBlock Text="👤 nombre_completo" Foreground="{StaticResource TextoPrincipal}" FontSize="11" Margin="8,2"/>
                                            <TextBlock Text="🖼️ file_portada_alta" Foreground="{StaticResource TextoPrincipal}" FontSize="11" Margin="8,2,8,6"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- DESTINO 2: HOJA LIENZOS / POSES -->
                                    <Border Canvas.Left="380" Canvas.Top="200" Width="180" Background="#2D2D30" CornerRadius="4" BorderBrush="{StaticResource BordeContenedor}" BorderThickness="1">
                                        <StackPanel>
                                            <Border Background="#3E3E42" Padding="8,4">
                                                <TextBlock Text="Destino: Hoja_Lienzos (.txt)" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="🔗 numero_orden" Foreground="{StaticResource TextoSecundario}" FontSize="11" Margin="8,4,8,2"/>
                                            <TextBlock Text="📷 file_sentado" Foreground="{StaticResource TextoPrincipal}" FontSize="11" Margin="8,2"/>
                                            <TextBlock Text="📷 file_muro" Foreground="{StaticResource TextoPrincipal}" FontSize="11" Margin="8,2"/>
                                            <TextBlock Text="📷 file_ventana" Foreground="{StaticResource TextoPrincipal}" FontSize="11" Margin="8,2,8,6"/>
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>
