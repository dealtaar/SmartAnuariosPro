<Window x:Class="SmartAnuariosPro.Views.ResizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redimensionar Fotos para Escoger" 
        Height="320" Width="450"
        WindowStyle="None" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" 
        AllowsTransparency="True"
        BorderBrush="#3F3F46" 
        BorderThickness="1">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Cabecera -->
            <RowDefinition Height="*"/>
            <!-- Controles de Porcentaje -->
            <RowDefinition Height="Auto"/>
            <!-- Alertas / Info -->
            <RowDefinition Height="Auto"/>
            <!-- Botones de Acción -->
        </Grid.RowDefinitions>

        <!-- CABECERA DE LA VENTANA -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="PROCESAMIENTO DE IMÁGENES (PASO 3)" 
                       Foreground="#8E8E93" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Optimizar Tamaño para Galería Web" 
                       Foreground="#FFFFFF" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- CONTROLES DE CONFIGURACIÓN -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Checkbox de Relación de Aspecto (Bloqueado por regla de negocio) -->
            <CheckBox x:Name="ChkAspectRatio" 
                      Content="Preservar Relación de Aspecto (Fijo)" 
                      IsChecked="True" 
                      IsEnabled="False" 
                      Foreground="#A1A1AA" 
                      Margin="0,0,0,15"
                      Focusable="False"/>

            <!-- Control de Ancho (Width) -->
            <Grid Margin="0,5,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="65"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ancho (W):" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                <Slider x:Name="SldWidth" Grid.Column="1" Minimum="10" Maximum="100" Value="50" 
                        TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        Foreground="#007ACC" ValueChanged="SldWidth_ValueChanged"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ElementName=SldWidth, Path=Value}" Foreground="#007ACC" FontWeight="Bold"/>
                    <TextBlock Text=" %" Foreground="#A1A1AA"/>
                </StackPanel>
            </Grid>

            <!-- Control de Alto (Height) -->
            <Grid Margin="0,5,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="65"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Alto (H):" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                <Slider x:Name="SldHeight" Grid.Column="1" Minimum="10" Maximum="100" Value="50" 
                        TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        Foreground="#007ACC" ValueChanged="SldHeight_ValueChanged"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ElementName=SldHeight, Path=Value}" Foreground="#007ACC" FontWeight="Bold"/>
                    <TextBlock Text=" %" Foreground="#A1A1AA"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- RECUADRO INFORMATIVO DE DESTINO -->
        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="0,10,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Foreground="#E1B12C" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock 
                           Foreground="#A1A1AA" FontSize="11" TextWrapping="Wrap" Width="370" VerticalAlignment="Center"><Run Text="Las fotos originales NO sufren cambios. Las copias ligeras se clonarán en la carpeta física "/><Run Language="es-es" Text="&quot;"/><Run Text="Fotos para Escoger"/><Run Language="es-es" Text="&quot;"/><Run Text=" listas para el hosting."/></TextBlock>
            </StackPanel>
        </Border>

        <!-- BOTONERA INFERIOR -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtStatus" Text="Listo para procesar." Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="Cancelar" Width="90" Height="30" Margin="0,0,10,0"
                    Background="#2D2D30" Foreground="#F4F4F5" BorderBrush="#3F3F46"
                    Click="BtnCancelar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="2" Content="Redimensionar" Width="120" Height="30"
                    Background="#007ACC" Foreground="#FFFFFF" BorderBrush="Transparent" FontWeight="SemiBold"
                    Click="BtnRedimensionar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>